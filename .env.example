# Local development settings — copy to .env and fill in.
# .env is gitignored; never commit real values.
#
# Same KEY=VALUE schema as the GCP `env-file` secret: Cloud Run
# mounts it as the DOTENV env var and settings.py parses it like
# this file. Multiline values go in double quotes with \n escapes.

DJANGO_SECRET_KEY=safe_key
DEBUG=true
APP_BASE_URL=https://127.0.0.1:8000

# Postgres URL; sslmode/sslrootcert query params land in
# DATABASES['default']['OPTIONS'] via dj_database_url.
DATABASE_URL=postgres://user:password@host:port/db?sslmode=require

GOCARDLESS_SECRET_ID=your_gocardless_secret_id
GOCARDLESS_SECRET_KEY=your_gocardless_secret_key
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:you@example.com

# Optional locally: without it, settings.py falls back to the
# gitignored google_api/app_secrets.json file instead.
# GOOGLE_OAUTH_CLIENT_JSON="{\"web\": {...escaped json...}}"
