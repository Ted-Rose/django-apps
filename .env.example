# Local development settings — copy to .env and fill in.
# .env is gitignored; never commit real values.
#
# Same KEY=VALUE schema as the GCP `env-file` secret: Cloud Run
# mounts it as the DOTENV env var and settings.py parses it like
# this file. Multiline values go in double quotes with \n escapes.

DJANGO_SECRET_KEY=safe_key
DEBUG=true
APP_BASE_URL=https://127.0.0.1:8000

# Postgres URL; sslmode/sslrootcert query params land in
# DATABASES['default']['OPTIONS'] via dj_database_url.
DATABASE_URL=postgres://user:password@host:port/db?sslmode=require

# Separate staging database — picked over DATABASE_URL whenever
# APP_ENV=staging (Cloud Run staging service) or
# VERCEL_ENV=preview. Also in the shared env-file GCP secret.
STAGING_DATABASE_URL=postgres://user:password@host:port/db?sslmode=require

# PEM of the DB CA cert — needed for sslmode=verify-ca/verify-full.
# In cloud environments settings.py writes it to /tmp/ca.pem and
# points sslrootcert there; locally a relative sslrootcert
# resolves the gitignored ca.pem at the repo root instead.
# DB_SSL_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----\n"

# TTS audio on Vercel: GCS bucket + service-account JSON key
# (`terraform output -raw vercel_audio_sa_key_json`) — lambdas have
# no GCP metadata server. Optional locally.
# GCS_AUDIO_BUCKET=
# GCP_SERVICE_ACCOUNT_JSON="{\"type\": \"service_account\", ...}"

GOCARDLESS_SECRET_ID=your_gocardless_secret_id
GOCARDLESS_SECRET_KEY=your_gocardless_secret_key
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:you@example.com

# Optional locally: without it, settings.py falls back to the
# gitignored google_api/app_secrets.json file instead.
# GOOGLE_OAUTH_CLIENT_JSON="{\"web\": {...escaped json...}}"

# Sentry DSNs — empty means the SDKs never initialize (no-op
# everywhere). SENTRY_DSN feeds sentry_sdk in settings.py;
# SENTRY_WEB_DSN ships to the SPA via the spa-bootstrap JSON.
SENTRY_DSN=
SENTRY_WEB_DSN=
