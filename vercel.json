{
  "version": 2,
  "regions": ["fra1"],
  "builds": [
    {
      "src": "build_files.sh",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "staticfiles"
      }
    },
    {
      "src": "django_apps/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.12",
        "functions": {
          "django_apps/wsgi.py": {
            "maxDuration": 300
          }
        }
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "django_apps/wsgi.py"
    }
  ],
  "headers": [
    {
      "source": "/static/(.*\\.[0-9A-Za-z_-]{8,}\\..*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
