{
  "version": 2,
  "builds": [
    {
      "src": "build_files.sh",
      "use": "@vercel/static-build",
      "config": {
          "distDir": "staticfiles"
      }
    },
    {
    "src": "django_apps/wsgi.py",
    "use": "@vercel/python",
    "config": {
      "maxLambdaSize": "15mb",
      "runtime": "python3.12",
      "excludeFiles": "{**/node_modules/**,venv/**,terraform/**}"
    }
  }],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "static/$1"
    },
    {
        "src":"/(.*)",
        "dest":"django_apps/wsgi.py"
    }
  ]
}