{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // Docs: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            // Full React dev loop in one entry: the "vite dev
            // server" background task (tasks.json) starts vite on
            // :5373, then runsslserver serves Django over HTTPS on
            // :8001 with VITE_DEV=1 so {% vite_asset %} emits :5373
            // URLs (dev_server_port in settings.py also reads
            // VITE_PORT). Stopping the session kills the vite task.
            // Browse https://localhost:8001/ — django-sslserver's
            // bundled dev cert is self-signed, so accept the
            // browser warning once.
            //
            // internalConsole keeps debugpy out of the integrated
            // terminal: no `source venv/bin/activate` echo before
            // the launcher (it already uses venv python by absolute
            // path) and no shell-init stall — a stale
            // ~/.pyenv/shims/.pyenv-shim lock used to block the
            // launcher past the adapter's connect timeout.
            //
            // Non-default ports on both sides: another project's
            // server squatting on :8000/:5173 makes the page hang
            // ("Loading React app…" / browser timeout).
            "name": "Django + Vite (dev loop)",
            "type": "debugpy",
            "request": "launch",
            "args": [
                "runsslserver",
                "8001"
            ],
            "django": true,
            "autoStartBrowser": false,
            "program": "${workspaceFolder}/manage.py",
            "console": "internalConsole",
            "preLaunchTask": "vite dev server",
            "env": {
                "VITE_DEV": "1",
                "VITE_PORT": "5373",
                "REQUESTS_CA_BUNDLE":
                    "${env:HOME}/.config/nscacert_system.pem",
                "SSL_CERT_FILE":
                    "${env:HOME}/.config/nscacert_system.pem",
                "HTTPLIB2_CA_CERTS":
                    "${env:HOME}/.config/nscacert_system.pem",
                "GRPC_DEFAULT_SSL_ROOTS_FILE_PATH":
                    "${env:HOME}/.config/nscacert_system.pem"
            }
        }
    ]
}
